Ques: Code for Encapsulation & Abstarction in C++?
Ans:
#include <iostream>
using namespace std;
//Encapsulation & Abstarction

class Student
{
  string name;
  int age;
  
  public:
  //setter function: set the private data members
  void setter(string n ,int a)
  {
    name = n;
    age = a;
  }
  
  //getter function: return the private data member value
  int getter()
  {
    return age;
  }
  
  void display()
  {
    cout<<name<<" "<<age<<endl;
  }
  
  ~Student()
  {
    cout<<"Destructor called"<<endl;
  }
  
  
  
  
};
int main() 
{
  Student obj1;
  obj1.setter("Hitesh",25);
  cout<<obj1.getter();
  
  
    
    return 0;
}
