Ques 1:- Insertion Sort Using Iterative Approach ? O(N^2)
Ans: 
int main()
{
    int arr[5] = {4,5,6,2,8};
    
    for(int i=1;i<=4;i++)
    {
        for(int j=i;j>0;j--)
        {
            if(arr[j]<arr[j-1])
            swap(arr[j],arr[j-1]);
        }
    }
    
    for(int i=0;i<5;i++)
    cout<<arr[i]<<" ";

    return 0;
}
