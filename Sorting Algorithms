Ques 3:- Selection Sort Using Interative Approach :-
Ans: 
int main()
{
    int arr[5] = {4,5,6,2,8};
    
    for(int i=0;i<=3;i++)
    {
        int index = i;
        
        for(int j=i+1;j<=4;j++)
        {
            if(arr[j]<arr[index])
            index = j;
        }
        
        swap(arr[index],arr[i]);
    }
    
    for(int i=0;i<5;i++)
    cout<<arr[i]<<" ";

    return 0;
}
